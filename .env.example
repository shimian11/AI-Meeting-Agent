# Java ↔ Python 内部鉴权令牌（两端必须一致）
BANMA_AGENT_TOKEN=change-me-in-prod

# 硅基流动：fast 档（Qwen 4B）+ embedding（bge-m3）共用
BANMA_SILICONFLOW_API_KEY=
BANMA_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
BANMA_SILICONFLOW_MODEL_FAST=Qwen/Qwen3.5-4B
BANMA_SILICONFLOW_MODEL_EMBED=BAAI/bge-m3

# DeepSeek 官方：strong 档（官方现行名 deepseek-flash）
BANMA_DEEPSEEK_API_KEY=
BANMA_DEEPSEEK_BASE_URL=https://api.deepseek.com
BANMA_DEEPSEEK_MODEL_STRONG=deepseek-flash

# 单次调用超时（秒）
BANMA_LLM_TIMEOUT_S=30

# ── 以下为「随环境变化」的项，**不要写在本文件** ──
# 按环境拆到独立文件（全部**不入库**），由进程环境变量 BANMA_ENV 决定加载哪一个（见 app/core/config.py）：
#   .env.local  → 本机开发（Qdrant 指向 VM 映射端口，采样 1.0）
#   .env.test   → 测试 VM（Qdrant 用 compose 服务名 banma-qdrant，采样 0.1）
#   .env.prod   → 生产云服务器
# 环境文件**禁止放任何 Key**（Key 只在本文件复制出的 .env 里）

# 模板 A · 本机开发（复制为 .env.local）
# BANMA_ENV=local
# BANMA_LOG_LEVEL=INFO
# BANMA_FAST_ENABLED=false
# BANMA_QDRANT_URL=
# BANMA_TRACE_FULL=false
# BANMA_TRACE_SAMPLE=1.0

# 模板 B · 测试 VM（复制为 .env.test）
# BANMA_ENV=test
# BANMA_LOG_LEVEL=INFO
# BANMA_FAST_ENABLED=false
# BANMA_QDRANT_URL=
# BANMA_TRACE_FULL=false
# BANMA_TRACE_SAMPLE=0.1

# 模板 C · 生产（复制为 .env.prod；值按 docs/ops/prod-env 复核）
# BANMA_ENV=prod
# 其余同模板 B

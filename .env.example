# 复制为 .env 后按需填写；.env 严禁入库
# 运行环境：local | prod | test
BANMA_ENV=local
# 日志级别：DEBUG | INFO | WARNING | ERROR
BANMA_LOG_LEVEL=INFO
# Java ↔ Python 内部鉴权令牌（两端必须一致）
BANMA_AGENT_TOKEN=change-me-in-prod

# 硅基流动：chat 与 embedding 共用同一把 Key（阶段 3 才用到）
BANMA_LLM_API_KEY=
BANMA_LLM_BASE_URL=https://api.siliconflow.cn/v1

# Qdrant（阶段 4 才用到；本地默认 compose 内网地址）
BANMA_QDRANT_URL=http://localhost:6333

# 调试开关：trace 里是否记录 prompt 全文；生产必须 false（ADR-010 脱敏要求）
BANMA_TRACE_FULL=false

#成功请求链路追踪采样率 0~1（失败请求始终 100% 采样）
BANMA_TRACE_SAMPLE=1.0